# API Configuration
# -----------------------------------------------------------------------------
# Development (default): Leave empty to use Vite proxy (http://localhost:3000)
# Production: Set to your API URL (e.g., https://api.reportcast.com)
# VITE_API_URL=

# Example production configuration:
# VITE_API_URL=https://api.reportcast.com

# Example local network testing (if not using proxy):
# VITE_API_URL=http://192.168.1.117:3000
