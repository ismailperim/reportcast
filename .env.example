# Deployment Mode
# on-premise: Free, no limits, all features (default)
# saas: Pricing, payments, user limits enabled
DEPLOYMENT_MODE=on-premise

# Admin Access (for on-premise deployments)
ADMIN_EMAIL=admin@example.com

# Docker Images (leave empty for latest, or specify version like "0.2.0")
API_VERSION=
WORKER_VERSION=

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=reportcast
DB_PASSWORD=reportcast_dev_password
DB_NAME=reportcast

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# TTS Server
TTS_SERVER_URL=http://tts-server:8000

# AI Providers
# Get your OpenAI key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_KEY_HERE
# Get your Anthropic key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_KEY_HERE

# TTS Providers (optional - for premium tiers)
# Get your ElevenLabs key from: https://elevenlabs.io/api-keys
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_KEY_HERE

# Authentication
JWT_SECRET=change_me_in_production_use_long_random_string

# Stripe (for payments - SaaS mode only)
# Get your keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Worker
WORKER_CONCURRENCY=2

# API
PORT=3000
NODE_ENV=development

# S3-Compatible Storage
# Options: minio (default), aws, digitalocean, cloudflare, backblaze
S3_PROVIDER=minio
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=reportcast
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000

# MinIO (if using default)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# AWS S3 (if using aws provider)
# S3_PROVIDER=aws
# S3_ENDPOINT=  # Leave empty for AWS
# S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# S3_BUCKET=my-reportcast-bucket
# S3_REGION=eu-central-1
# S3_PUBLIC_URL=https://my-reportcast-bucket.s3.eu-central-1.amazonaws.com
